{
  "name": "airloy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AirLoy — a complete airline frequent-flyer loyalty program: earn, status, and award redemption",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "tsc -b --noEmit",
    "smoke": "esbuild scripts/smoke.tsx --bundle --platform=node --format=cjs --jsx=automatic --log-level=error --outfile=node_modules/.tmp/smoke.cjs && node node_modules/.tmp/smoke.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.439.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.23.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
